# 开发库（Docker 映射到宿主机 5433，避免与本机 5432 冲突）
DATABASE_URL=postgresql+asyncpg://shop:shop@localhost:5433/shop
# 测试库；pytest 会自动使用
TEST_DATABASE_URL=postgresql+asyncpg://shop:shop@localhost:5433/shop_test

# 必填：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5175

# AI（可选）：不配置 DASHSCOPE_API_KEY 时客服使用本地规则 + 关键词检索
# AI_PROVIDER=auto            # auto / dashscope / local / fake
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CHAT_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIM=1024
# VISION_MODEL=qwen3-vl-flash
# ASR_MODEL=paraformer-v2
# DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# LLM_TIMEOUT_SECONDS=20

# 上传：图片 ≤5MB、语音 ≤10MB；目录相对 backend/，已加入 .gitignore
# MAX_IMAGE_UPLOAD_MB=5
# MAX_VOICE_UPLOAD_MB=10
# UPLOAD_DIR=static/uploads
